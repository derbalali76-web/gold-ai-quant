      "type": "object"
    },
    "DataFreshness": {
      "additionalProperties": false,
      "properties": {
        "bars_available": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Bars Available",
          "type": "object"
        },
        "is_fresh": {
          "title": "Is Fresh",
          "type": "boolean"
        },
        "max_allowed_seconds": {
          "title": "Max Allowed Seconds",
          "type": "number"
        },
        "quote_age_seconds": {
