{
  "$defs": {
    "Action": {
      "enum": [
        "BUY",
        "SELL",
        "WAIT",
        "UNAVAILABLE"
      ],
      "title": "Action",
      "type": "string"
    },
    "Check": {
      "additionalProperties": false,
      "description": "One entry condition (v1.7.3). ok=None means it cannot be checked right now (e.g. calendar not connected).",
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ok"
        }
      },
      "required": [
        "code"
      ],
      "title": "Check",
      "type": "object"
    },
    "CourtJudgement": {
      "additionalProperties": false,
      "description": "V4 AI Decision Court: one independent judge's ruling.",
      "properties": {
        "judge": {
          "title": "Judge",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reasons_ar": {
          "items": {
            "type": "string"
          },
          "title": "Reasons Ar",
          "type": "array"
        },
        "reasons_ref": {
          "items": {
            "$ref": "#/$defs/ReasonRef"
          },
          "title": "Reasons Ref",
          "type": "array"
        }
      },
      "required": [
        "judge",
        "passed"
      ],
      "title": "CourtJudgement",
      "type": "object"
    },
    "DailyBrief": {
      "additionalProperties": false,
      "description": "Every day, even when no trade is validated: today's bias and the two levels that would change the picture.",
      "properties": {
        "bias": {
          "title": "Bias",
          "type": "string"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "price": {
          "title": "Price",
          "type": "number"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/Scenario"
          },
          "title": "Scenarios",
          "type": "array"
        },
        "source": {
          "default": "H1_LEVELS",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "date",
        "bias",
        "price"
      ],
      "title": "DailyBrief",
      "type": "object"
    },
    "DataFreshness": {
      "additionalProperties": false,
      "properties": {
        "bars_available": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Bars Available",
          "type": "object"
        },
        "is_fresh": {
          "title": "Is Fresh",
          "type": "boolean"
        },
        "max_allowed_seconds": {
          "title": "Max Allowed Seconds",
          "type": "number"
        },
        "quote_age_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Age Seconds"
        }
      },
      "required": [
        "max_allowed_seconds",
        "is_fresh"
      ],
      "title": "DataFreshness",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "text_ar": {
          "title": "Text Ar",
          "type": "string"
        },
        "text_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "weight": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "engine",
        "text_ar",
        "weight"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "HorizonOutlook": {
      "additionalProperties": false,
      "description": "Per-horizon view: HOURS mirrors the main intraday decision; WEEK / MONTH come from daily rules.\n\nhit_rate is the historical FREQUENCY of the validated rule (non-overlapping, after costs) — never a\ncalibrated probability of this particular trade, and never reported for unvalidated rules or in DEMO.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "base_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Rate"
        },
        "checklist": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Checklist",
          "type": "array"
        },
        "entry_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Price"
        },
        "facts_ref": {
          "items": {
            "$ref": "#/$defs/ReasonRef"
          },
          "title": "Facts Ref",
          "type": "array"
        },
        "hit_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hit Rate"
        },
        "horizon": {
          "title": "Horizon",
          "type": "string"
        },
        "horizon_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon Days"
        },
        "label_ar": {
          "title": "Label Ar",
          "type": "string"
        },
        "levels": {
          "anyOf": [
            {
              "$ref": "#/$defs/LevelsBlock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "live_hits": {
          "default": 0,
          "minimum": 0,
          "title": "Live Hits",
          "type": "integer"
        },
        "live_resolved": {
          "default": 0,
          "minimum": 0,
          "title": "Live Resolved",
          "type": "integer"
        },
        "method_ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Ar"
        },
        "method_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "performance": {
          "items": {
            "$ref": "#/$defs/PerfStats"
          },
          "title": "Performance",
          "type": "array"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/TradePlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "probabilities_available": {
          "default": false,
          "title": "Probabilities Available",
          "type": "boolean"
        },
        "reason_ar": {
          "title": "Reason Ar",
          "type": "string"
        },
        "reason_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "samples": {
          "default": 0,
          "title": "Samples",
          "type": "integer"
        },
        "stance_ar": {
          "title": "Stance Ar",
          "type": "string"
        },
        "stance_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stop_loss": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Loss"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "tilt": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Tilt",
          "type": "integer"
        },
        "trend": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarketTrend"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validated": {
          "default": false,
          "title": "Validated",
          "type": "boolean"
        },
        "validation_ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Ar"
        },
        "validation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wait_for_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait For Price"
        },
        "warnings_ar": {
          "items": {
            "type": "string"
          },
          "title": "Warnings Ar",
          "type": "array"
        },
        "warnings_ref": {
          "items": {
            "$ref": "#/$defs/ReasonRef"
          },
          "title": "Warnings Ref",
          "type": "array"
        }
      },
      "required": [
        "horizon",
        "label_ar",
        "action",
        "stance_ar",
        "reason_ar"
      ],
      "title": "HorizonOutlook",
      "type": "object"
    },
    "HorizonProbability": {
      "additionalProperties": false,
      "properties": {
        "horizon_minutes": {
          "title": "Horizon Minutes",
          "type": "integer"
        },
        "oos_samples": {
          "title": "Oos Samples",
          "type": "integer"
        },
        "p_neither": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Neither",
          "type": "number"
        },
        "p_stop_first": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Stop First",
          "type": "number"
        },
        "p_target_first": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Target First",
          "type": "number"
        },
        "qualified": {
          "title": "Qualified",
          "type": "boolean"
        }
      },
      "required": [
        "horizon_minutes",
        "p_target_first",
        "p_stop_first",
        "p_neither",
        "qualified",
        "oos_samples"
      ],
      "title": "HorizonProbability",
      "type": "object"
    },
    "LevelsBlock": {
      "additionalProperties": false,
      "properties": {
        "atr_h1": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atr H1"
        },
        "method_note_ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Note Ar"
        },
        "resistances": {
          "items": {
            "$ref": "#/$defs/PriceLevel"
          },
          "title": "Resistances",
          "type": "array"
        },
        "supports": {
          "items": {
            "$ref": "#/$defs/PriceLevel"
          },
          "title": "Supports",
          "type": "array"
        },
        "validated": {
          "title": "Validated",
          "type": "boolean"
        },
        "validation_ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Ar"
        }
      },
      "required": [
        "validated"
      ],
      "title": "LevelsBlock",
      "type": "object"
    },
    "MarketTrend": {
      "additionalProperties": false,
      "description": "Analytical trend score (0-100) — NOT a probability.",
      "properties": {
        "agreement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agreement"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "label_ar": {
          "title": "Label Ar",
          "type": "string"
        },
        "note_ar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note Ar"
        },
        "per_timeframe": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Per Timeframe",
          "type": "object"
        },
        "strength": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strength"
        }
      },
      "required": [
        "direction",
        "label_ar"
      ],
      "title": "MarketTrend",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "DEMO",
        "LIVE"
      ],
      "title": "Mode",
      "type": "string"
    },
    "PerfStats": {
      "additionalProperties": false,
      "description": "Track record of one horizon from one source. Pending / never-filled signals are NOT counted as trades.",
      "properties": {
        "avg_loss": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avg Loss"
        },
        "avg_win": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avg Win"
        },
        "baseline_expectancy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Expectancy"
        },
        "direction_accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction Accuracy"
        },
        "direction_baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction Baseline"
        },
        "expectancy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expectancy"
        },
        "hits": {
          "default": 0,
          "minimum": 0,
          "title": "Hits",
          "type": "integer"
        },
        "max_drawdown": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Drawdown"
        },
        "not_filled": {
          "default": 0,
          "minimum": 0,
          "title": "Not Filled",
          "type": "integer"
        },
        "pending": {
          "default": 0,
          "minimum": 0,
          "title": "Pending",
          "type": "integer"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "qualified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualified"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "trades": {
          "default": 0,
          "minimum": 0,
          "title": "Trades",
          "type": "integer"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        }
      },
      "required": [
        "source",
        "unit"
      ],
      "title": "PerfStats",
      "type": "object"
    },
    "PriceLevel": {
      "additionalProperties": false,
      "properties": {
        "broken_recently": {
          "default": false,
          "title": "Broken Recently",
          "type": "boolean"
        },
        "distance_atr": {
          "title": "Distance Atr",
          "type": "number"
        },
        "last_test_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Test Utc"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "price": {
          "title": "Price",
          "type": "number"
        },
        "role_flip": {
          "default": false,
          "title": "Role Flip",
          "type": "boolean"
        },
        "strength": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strength"
        },
        "strength_label_ar": {
          "title": "Strength Label Ar",
          "type": "string"
        },
        "tests": {
          "title": "Tests",
          "type": "integer"
        },
        "timeframes": {
          "items": {
            "type": "string"
          },
          "title": "Timeframes",
          "type": "array"
        },
        "zone_high": {
          "title": "Zone High",
          "type": "number"
        },
        "zone_low": {
          "title": "Zone Low",
          "type": "number"
        }
      },
      "required": [
        "name",
        "price",
        "zone_low",
        "zone_high",
        "strength_label_ar",
        "tests",
        "distance_atr"
      ],
      "title": "PriceLevel",
      "type": "object"
    },
    "ReasonRef": {
      "additionalProperties": false,
      "description": "A translatable sentence: `code` + ordered `args` (strings or nested refs). `text_ar` is the Arabic rendering\nand the fallback for any code the client has no string for (code 'raw' = show text_ar as is).",
      "properties": {
        "args": {
          "items": {},
          "title": "Args",
          "type": "array"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "text_ar": {
          "title": "Text Ar",
          "type": "string"
        }
      },
      "required": [
        "code",
        "text_ar"
      ],
      "title": "ReasonRef",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "description": "A level-based scenario to WATCH today (v1.7.2). Not a recommendation: no probability, no position size.",
      "properties": {
        "invalidation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidation"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "target_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Level"
        },
        "trigger": {
          "title": "Trigger",
          "type": "number"
        },
        "trigger_level": {
          "title": "Trigger Level",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "trigger",
        "trigger_level"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "Setup": {
      "enum": [
        "BUY_NOW",
        "SELL_NOW",
        "WAIT_TO_BUY",
        "WAIT_TO_SELL",
        "WAIT",
        "UNAVAILABLE"
      ],
      "title": "Setup",
      "type": "string"
    },
    "SpotOrProxy": {
      "enum": [
        "SPOT",
        "PROXY",
        "SYNTHETIC",
        "NONE"
      ],
      "title": "SpotOrProxy",
      "type": "string"
    },
    "TradePlan": {
      "additionalProperties": false,
      "description": "What the user can act on for ONE horizon (v1.7).\n\nrecommendation=True only for a LIVE, validated *_NOW plan. WAIT_TO_* is a WATCH level (where a setup would be\nlooked for), never a recommendation: it carries no stop or target, so it cannot be mistaken for a trade.",
      "properties": {
        "entry_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry High"
        },
        "entry_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Low"
        },
        "expected_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Days"
        },
        "expected_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Minutes"
        },
        "expected_net_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Net Return Pct"
        },
        "fill_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill Days"
        },
        "invalidation_refs": {
          "items": {
            "$ref": "#/$defs/ReasonRef"
          },
          "title": "Invalidation Refs",
