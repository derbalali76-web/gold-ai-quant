      "additionalProperties": false,
      "description": "V4 AI Decision Court: one independent judge's ruling.",
      "properties": {
        "judge": {
          "title": "Judge",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reasons_ar": {
          "items": {
            "type": "string"
