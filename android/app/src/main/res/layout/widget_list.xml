<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wl_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/app_name"
            android:textColor="#D4AF37" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/wl_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8C8A83" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wl_n0" android:layout_width="52dp" android:layout_height="wrap_content" android:maxLines="1"
            android:textColor="#F3F1EA" android:textSize="13sp" android:textStyle="bold" />
        <ImageView android:id="@+id/wl_s0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp"
            android:layout_marginHorizontal="6dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <TextView android:id="@+id/wl_p0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
            android:textDirection="ltr" android:textColor="#F4F4F4" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/wl_c0" android:layout_width="56dp" android:layout_height="wrap_content" android:maxLines="1"
            android:gravity="center" android:textDirection="ltr" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/wl_i0" android:layout_width="50dp" android:layout_height="wrap_content" android:maxLines="1"
            android:gravity="center" android:background="@drawable/widget_chip" android:paddingVertical="1dp"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wl_n1" android:layout_width="52dp" android:layout_height="wrap_content" android:maxLines="1"
            android:textColor="#F3F1EA" android:textSize="13sp" android:textStyle="bold" />
        <ImageView android:id="@+id/wl_s1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp"
            android:layout_marginHorizontal="6dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <TextView android:id="@+id/wl_p1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
            android:textDirection="ltr" android:textColor="#F4F4F4" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/wl_c1" android:layout_width="56dp" android:layout_height="wrap_content" android:maxLines="1"
            android:gravity="center" android:textDirection="ltr" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/wl_i1" android:layout_width="50dp" android:layout_height="wrap_content" android:maxLines="1"
            android:gravity="center" android:background="@drawable/widget_chip" android:paddingVertical="1dp"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wl_n2" android:layout_width="52dp" android:layout_height="wrap_content" android:maxLines="1"
            android:textColor="#F3F1EA" android:textSize="13sp" android:textStyle="bold" />
        <ImageView android:id="@+id/wl_s2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp"
            android:layout_marginHorizontal="6dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <TextView android:id="@+id/wl_p2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
            android:textDirection="ltr" android:textColor="#F4F4F4" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/wl_c2" android:layout_width="56dp" android:layout_height="wrap_content" android:maxLines="1"
            android:gravity="center" android:textDirection="ltr" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/wl_i2" android:layout_width="50dp" android:layout_height="wrap_content" android:maxLines="1"
            android:gravity="center" android:background="@drawable/widget_chip" android:paddingVertical="1dp"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wl_n3" android:layout_width="52dp" android:layout_height="wrap_content" android:maxLines="1"
            android:textColor="#F3F1EA" android:textSize="13sp" android:textStyle="bold" />
        <ImageView android:id="@+id/wl_s3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="18dp"
            android:layout_marginHorizontal="6dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <TextView android:id="@+id/wl_p3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
            android:textDirection="ltr" android:textColor="#F4F4F4" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/wl_c3" android:layout_width="56dp" android:layout_height="wrap_content" android:maxLines="1"
            android:gravity="center" android:textDirection="ltr" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/wl_i3" android:layout_width="50dp" android:layout_height="wrap_content" android:maxLines="1"
            android:gravity="center" android:background="@drawable/widget_chip" android:paddingVertical="1dp"
            android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
