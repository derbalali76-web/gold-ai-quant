<?xml version="1.0" encoding="utf-8"?>
<!-- Owner design 2026-11-26: glowing gold frame (9-patch by size), asset art bottom-left, price column on the
     right, idea column on the left. Frame chosen in code by the widget's shape (wide / compact). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wf_wide">
    <ImageView
        android:id="@+id/w_art"
        android:layout_width="wrap_content"
        android:layout_height="84dp"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="8dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:id="@+id/w_price_col"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/w_pair" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textColor="#F3F1EA" android:textSize="13sp" android:textStyle="bold" android:paddingVertical="3dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name"
                    android:textColor="#E6C55A" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/w_price" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="right" android:textDirection="ltr" android:maxLines="1" android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="34sp"
                android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_chg" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="right" android:textDirection="ltr" android:maxLines="1" android:textSize="13sp" android:textStyle="bold" />
            <ImageView android:id="@+id/w_spark" android:layout_width="match_parent" android:layout_height="34dp"
                android:layout_marginTop="4dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_time" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="#A3A3A8" android:textSize="10sp" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/w_sep"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#332A2A2D" />
        <LinearLayout
            android:id="@+id/w_idea_col"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView android:id="@+id/w_who" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingVertical="3dp" android:maxLines="1" android:ellipsize="end" android:textColor="#B5B3AC" android:textSize="12sp" />
            <TextView android:id="@+id/w_act" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:paddingHorizontal="12dp" android:paddingVertical="2dp"
                android:background="@drawable/wchip_blue" android:maxLines="1" android:textColor="#8FC1EA"
                android:textSize="18sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingLeft="52dp" android:layout_marginTop="4dp">
                <TextView android:id="@+id/w_l1" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#F3F1EA" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_l2" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#F3F1EA" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_note" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#E6C55A" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
