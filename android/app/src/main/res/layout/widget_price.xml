<?xml version="1.0" encoding="utf-8"?>
<!-- Owner-approved 2026-11-26 (design board «ويدجت مقترح» option 2): idea for your position | price, today's move,
     sparkline. Narrow widgets hide the idea column (PriceWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="14dp">
    <LinearLayout
        android:id="@+id/w_idea_col"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView android:id="@+id/w_who" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="3dp"
            android:maxLines="1" android:ellipsize="end" android:textColor="#8C8A83" android:textSize="12sp" />
        <TextView android:id="@+id/w_act" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textColor="#E6C55A" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_l1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textColor="#F3F1EA" android:textSize="13sp" />
        <TextView android:id="@+id/w_l2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textColor="#F3F1EA" android:textSize="13sp" />
        <TextView android:id="@+id/w_note" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textColor="#8C8A83" android:textSize="10sp" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/w_sep"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="#2A2A2D" />
    <LinearLayout
        android:id="@+id/w_price_col"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/w_pair" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textColor="#F3F1EA" android:textSize="12sp" android:textStyle="bold" android:paddingVertical="3dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name"
                android:textColor="#D4AF37" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/w_price" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="end" android:textDirection="ltr" android:maxLines="1" android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="30sp"
            android:textColor="#F4F4F4" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_chg" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="end" android:maxLines="1" android:textSize="13sp" android:textStyle="bold" />
        <ImageView android:id="@+id/w_spark" android:layout_width="match_parent" android:layout_height="26dp"
            android:layout_marginTop="4dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="end" android:textColor="#8C8A83" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
