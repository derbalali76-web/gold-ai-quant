<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ws_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/ws_pair" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#F3F1EA" android:textSize="13sp" android:textStyle="bold" android:paddingVertical="2dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name"
            android:textColor="#D4AF37" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/ws_price" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="end" android:textDirection="ltr" android:maxLines="1"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="32sp"
        android:textColor="#F4F4F4" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:id="@+id/ws_chg" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="end" android:maxLines="1" android:textSize="13sp" android:textStyle="bold" />
    <ImageView android:id="@+id/ws_spark" android:layout_width="match_parent" android:layout_height="28dp"
        android:layout_marginTop="6dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <TextView android:id="@+id/ws_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#8C8A83" android:textSize="10sp" />
</LinearLayout>
