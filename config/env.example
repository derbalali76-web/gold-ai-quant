# انسخ إلى ملف .env أو اضبطها في الطرفية قبل تشغيل الخادم
TWELVEDATA_API_KEY=          # مفتاح مجاني من twelvedata.com (بدون بطاقة)
GOLDQUANT_TOKEN=             # اختياري: رمز سري يُطلب من التطبيق
GOLDQUANT_DATA_DIR=data
GOLDQUANT_XAUS_CHECK=1       # تحقق متقاطع من السعر عبر xaus.com
GOLDQUANT_CONTEXT=1          # FRED + CFTC + RSS + التقويم
